# Copy to .env and fill in. Never commit .env.
# Generate all secrets + VAPID keys at once:  backend/.venv/Scripts/python backend/scripts/gen_env.py

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=caretaker
POSTGRES_PASSWORD=
POSTGRES_DB=caretaker

# --- Backend ---
# Local (non-docker) backend uses this; docker compose overrides host to "db".
DATABASE_URL=postgresql+psycopg://caretaker:CHANGE_ME@127.0.0.1:5432/caretaker
# Test suite database (created automatically by the db container).
TEST_DATABASE_URL=postgresql+psycopg://caretaker:CHANGE_ME@127.0.0.1:5432/caretaker_test

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Web Push (VAPID). Private key stays on the server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Push services the server may POST to (subdomains included). Blocks SSRF via fake endpoints.
PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,push.services.mozilla.com,notify.windows.com,push.apple.com

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# HMAC key used to hash per-device API keys.
DEVICE_API_SECRET=

# Set to production to enable secure cookies and disable dev seed endpoints.
ENVIRONMENT=development

# Defaults for the medicine engine (admins can override them in the app).
MISSED_DOSE_TIMEOUT_MINUTES=60
LATE_DOSE_AFTER_MINUTES=30
DEVICE_WARNING_AFTER_MINUTES=5
DEVICE_OFFLINE_AFTER_MINUTES=15
SCHEDULER_INTERVAL_SECONDS=30
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Frontend (build time) ---
# Enables /dev/simulator in production builds (always on in `npm run dev`).
VITE_ENABLE_SIMULATOR=false
